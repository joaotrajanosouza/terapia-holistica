---
import SeoHead from '@components/SeoHead.astro';
import { localBusinessJsonLd } from '@lib/seo';
import type { SeoProps } from '@lib/seo';
import '@styles/global.css';

type Props = SeoProps & {
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const businessJsonLd = localBusinessJsonLd();
const extraJsonLd = Astro.props.jsonLd
  ? Array.isArray(Astro.props.jsonLd)
    ? Astro.props.jsonLd
    : [Astro.props.jsonLd]
  : [];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F7F6F1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SeoHead {...Astro.props} jsonLd={[businessJsonLd, ...extraJsonLd]} />

    <!-- Analytics/Pixel entram aqui SOMENTE após consentimento de cookies,
         disparados via script próprio — nunca carregados incondicionalmente. -->
  </head>
  <body class="antialiased">
    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
