---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsappFab from '@components/WhatsappFab.astro';
import { articleJsonLd, breadcrumbJsonLd } from '@lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();

const jsonLd = [
  articleJsonLd({
    title: post.data.title,
    description: post.data.description,
    path: `/blog/${post.slug}`,
    publishDate: post.data.publishDate,
    updatedDate: post.data.updatedDate,
  }),
  breadcrumbJsonLd([
    { name: 'Início', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.data.title, path: `/blog/${post.slug}` },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.slug}`}
  type="article"
  jsonLd={jsonLd}
>
  <Header />
  <main class="px-4 py-12 md:px-6 md:py-16">
    <div class="mx-auto max-w-2xl">
      <a href="/blog" class="text-sm text-[color:var(--ink-soft)] transition-colors hover:text-[color:var(--accent)]">
        ← Voltar para o blog
      </a>
      <article class="mt-4">
        <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{post.data.title}</h1>
        <time datetime={post.data.publishDate.toISOString()} class="mt-2 block text-sm text-[color:var(--ink-soft)]">
          {post.data.publishDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <div class="prose prose-neutral prose-headings:font-display prose-headings:tracking-tight prose-a:text-[color:var(--accent)] mt-8 max-w-none">
          <Content />
        </div>
      </article>
    </div>
  </main>
  <WhatsappFab />
  <Footer />
</BaseLayout>
