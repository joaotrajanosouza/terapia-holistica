---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsappFab from '@components/WhatsappFab.astro';
import { articleJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { SITE } from '@lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();
const articleImage = post.data.cover?.src ?? SITE.images.hero;
const articleImageUrl = new URL(articleImage, SITE.url).toString();
const publishedTime = post.data.publishDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.publishDate).toISOString();

const jsonLd = [
  articleJsonLd({
    title: post.data.title,
    description: post.data.description,
    path: `/blog/${post.slug}`,
    publishDate: post.data.publishDate,
    updatedDate: post.data.updatedDate,
    image: articleImageUrl,
    imageAlt: post.data.coverAlt ?? post.data.title,
    tags: post.data.tags,
  }),
  breadcrumbJsonLd([
    { name: 'Início', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.data.title, path: `/blog/${post.slug}` },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.slug}`}
  type="article"
  image={articleImageUrl}
  imageAlt={post.data.coverAlt ?? post.data.title}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  section="Terapia Holística"
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <Header />
  <main transition:animate="slide" class="px-4 py-12 md:px-6 md:py-16">
    <div class="mx-auto max-w-2xl">
      <a href="/blog" class="inline-flex items-center gap-1 text-sm text-[color:var(--ink-soft)] transition-colors hover:text-[color:var(--accent)]">
        ← Voltar para o blog
      </a>
      <article class="mt-4">
        <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{post.data.title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[color:var(--ink-soft)]">
          <span>Por {SITE.therapistName}</span>
          <span aria-hidden="true">·</span>
          <time datetime={publishedTime}>
          {post.data.publishDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        {post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Temas do artigo">
            {post.data.tags.map((tag) => (
              <li class="rounded-full bg-[color:var(--accent-soft)] px-3 py-1 text-xs font-medium text-[color:var(--accent)]">{tag}</li>
            ))}
          </ul>
        )}
        <div class="prose prose-neutral prose-headings:font-display prose-headings:tracking-tight prose-a:text-[color:var(--accent)] mt-8 max-w-none">
          <Content />
        </div>
      </article>
    </div>
  </main>
  <WhatsappFab />
  <Footer />
</BaseLayout>
