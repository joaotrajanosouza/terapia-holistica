---
import { SITE, whatsappLink } from '@lib/site';
import { ArrowUpRight, Menu, MessageCircle, X } from 'lucide-react';

const nav = [
  { label: 'Início', href: '/#hero', id: 'hero' },
  { label: 'Sobre', href: '/#sobre', id: 'sobre' },
  { label: 'Serviços', href: '/#servicos', id: 'servicos' },
  { label: 'Como funciona', href: '/#processo', id: 'processo' },
  { label: 'Blog', href: '/blog', id: 'blog' },
  { label: 'Contato', href: '/#contato', id: 'contato' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-transparent bg-[color:var(--bg)]/90 backdrop-blur-md transition-[border-color,box-shadow] duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 md:px-6 md:py-4">
    <a href="/" class="flex items-center gap-2.5">
      <img
        src={SITE.images.logo}
        alt={SITE.therapistName}
        width="34"
        height="34"
        class="h-8 w-8 rounded-full object-cover"
      />
      <span class="font-display text-sm font-semibold tracking-tight md:text-base">{SITE.therapistName}</span>
    </a>

    <nav aria-label="Navegação principal" id="desktop-nav" class="relative hidden gap-1 text-sm md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-section={item.id}
          class="relative rounded-full px-3 py-2 font-medium text-[color:var(--ink-soft)] transition-colors hover:text-[color:var(--ink)] data-[active=true]:text-[color:var(--accent)]"
        >
          {item.label}
        </a>
      ))}
      <span class="nav-indicator" id="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="group hidden items-center gap-1.5 rounded-full bg-[color:var(--accent)] px-4 py-2.5 text-sm font-semibold text-white shadow-[var(--shadow-soft)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--accent-strong)] hover:shadow-[var(--shadow-accent)] md:inline-flex"
      >
        Agendar sessão
        <ArrowUpRight size={15} strokeWidth={2.2} className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menu"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-[color:var(--border)] bg-[color:var(--surface)] text-[color:var(--ink)] shadow-[var(--shadow-soft)] transition-colors hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] md:hidden"
      >
        <Menu id="icon-open" size={20} strokeWidth={1.8} aria-hidden="true" />
        <X id="icon-close" size={20} strokeWidth={1.8} aria-hidden="true" className="hidden" />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-nav-backdrop"
  class="fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>
<nav
  id="mobile-nav"
  aria-label="Navegação mobile"
   class="fixed inset-y-0 right-0 z-50 flex w-[86%] max-w-sm translate-x-full flex-col gap-1 bg-[color:var(--surface)] px-5 pb-6 pt-24 shadow-[var(--shadow-lift)] transition-transform duration-350 ease-[cubic-bezier(0.16,1,0.3,1)] md:hidden"
>
  <p class="mb-4 px-3 text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ink-soft)]">Navegar</p>
  {nav.map((item) => (
    <a
      href={item.href}
      class="group flex items-center justify-between rounded-2xl px-3 py-3.5 font-medium text-[color:var(--ink)] transition-all hover:translate-x-1 hover:bg-[color:var(--accent-soft)] hover:text-[color:var(--accent)]"
    >
      {item.label}
      <ArrowUpRight size={16} strokeWidth={1.8} className="opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true" />
    </a>
  ))}
  <a
    href={whatsappLink()}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-[color:var(--accent)] px-4 py-3.5 text-center text-sm font-semibold text-white shadow-[var(--shadow-accent)]"
  >
    <MessageCircle size={17} strokeWidth={2} aria-hidden="true" />
    Agendar sessão
  </a>
</nav>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header?.classList.toggle('border-[color:var(--border)]', scrolled);
    header?.classList.toggle('shadow-[var(--shadow-soft)]', scrolled);
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const backdrop = document.getElementById('mobile-nav-backdrop');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setMenu(open: boolean) {
    mobileNav?.classList.toggle('translate-x-full', !open);
    backdrop?.classList.toggle('opacity-0', !open);
    backdrop?.classList.toggle('pointer-events-none', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
  }

  toggle?.addEventListener('click', () => setMenu(mobileNav?.classList.contains('translate-x-full') ?? true));
  backdrop?.addEventListener('click', () => setMenu(false));
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  const desktopNav = document.getElementById('desktop-nav');
  const indicator = document.getElementById('nav-indicator');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  function moveIndicatorTo(link: HTMLAnchorElement | undefined) {
    if (!link || !indicator || !desktopNav) return;
    const navRect = desktopNav.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    indicator.style.width = `${linkRect.width - 24}px`;
    indicator.style.transform = `translateX(${linkRect.left - navRect.left + 12}px)`;
    indicator.style.opacity = '1';
  }

  const isHome = window.location.pathname === '/';
  if (isHome) {
    const sections = links
      .map((link) => link.dataset.section)
      .filter((id): id is string => !!id && id !== 'blog')
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        const activeId = visible.target.id;
        links.forEach((link) => link.dataset.active = String(link.dataset.section === activeId));
        moveIndicatorTo(links.find((link) => link.dataset.section === activeId));
      },
      { threshold: [0.3, 0.6], rootMargin: '-96px 0px -50% 0px' }
    );
    sections.forEach((section) => spy.observe(section));
  } else {
    const active = links.find((link) => link.getAttribute('href') === window.location.pathname);
    if (active) {
      active.dataset.active = 'true';
      moveIndicatorTo(active);
    }
  }

  window.addEventListener('resize', () => {
    const active = links.find((link) => link.dataset.active === 'true');
    moveIndicatorTo(active);
  });
</script>
