---
type Props = {
  items: { question: string; answer: string }[];
};
const { items } = Astro.props;
---

<div class="flex flex-col divide-y divide-[color:var(--border)] rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)]">
  {items.map((item) => (
    <details class="group px-5 py-4 first:rounded-t-2xl last:rounded-b-2xl">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
        {item.question}
        <span
          class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-[color:var(--border)] text-sm leading-none transition-transform group-open:rotate-45 group-open:border-[color:var(--accent)] group-open:text-[color:var(--accent)]"
          aria-hidden="true"
        >
          +
        </span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-[color:var(--ink-soft)]">{item.answer}</p>
    </details>
  ))}
</div>
