---
import { buildSeo, type SeoProps } from '@lib/seo';

type Props = SeoProps & {
  // JSON-LD extra específico da página (ex.: FAQPage, Article), além do
  // LocalBusiness que já é injetado globalmente no BaseLayout.
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const seo = buildSeo(Astro.props);
const jsonLdBlocks = Astro.props.jsonLd
  ? Array.isArray(Astro.props.jsonLd)
    ? Astro.props.jsonLd
    : [Astro.props.jsonLd]
  : [];
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={seo.robots} />
<link rel="canonical" href={seo.canonical} />

<!-- Open Graph -->
<meta property="og:type" content={seo.type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />

{jsonLdBlocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
