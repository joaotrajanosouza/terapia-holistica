---
import { SITE } from '@lib/site';
---

<footer class="border-t border-[color:var(--border)] bg-[color:var(--bg-alt)] py-12">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="flex flex-col gap-8 text-sm md:flex-row md:justify-between">
      <div class="flex max-w-sm items-start gap-3">
        <img
          src={SITE.images.logo}
          alt=""
          aria-hidden="true"
          width="38"
          height="38"
          loading="lazy"
          class="h-[38px] w-[38px] rounded-full object-cover"
        />
        <div>
          <p class="font-display font-semibold tracking-tight">{SITE.name}</p>
          <p class="mt-2 text-[color:var(--ink-soft)]">
            Transformando vidas através da gestão emocional comportamental e terapia holística.
            Atendimento online para {SITE.address.areaServed.join(', ')} e todo o Brasil.
          </p>
        </div>
      </div>

      <div>
        <p class="font-display text-xs font-semibold uppercase tracking-widest text-[color:var(--ink-soft)]">Contato</p>
        <ul class="mt-3 space-y-1.5 text-[color:var(--ink-soft)]">
          <li>{SITE.address.locality} — {SITE.address.region} | Atendimento online</li>
          <li>{SITE.phoneDisplay}</li>
          <li><a href={`mailto:${SITE.email}`} class="hover:text-[color:var(--accent)]">{SITE.email}</a></li>
        </ul>
      </div>

      <div>
        <p class="font-display text-xs font-semibold uppercase tracking-widest text-[color:var(--ink-soft)]">Redes</p>
        <ul class="mt-3 space-y-1.5 text-[color:var(--ink-soft)]">
          <li><a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--accent)]">Instagram</a></li>
          <li><a href={SITE.social.tiktok} target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--accent)]">TikTok</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-[color:var(--border)] pt-6 text-xs text-[color:var(--ink-soft)] md:flex-row md:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. Todos os direitos reservados.</p>
      <p>Este site é informativo e não substitui acompanhamento médico ou psicológico.</p>
    </div>
  </div>
</footer>
