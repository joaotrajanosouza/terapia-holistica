---
import { Quote } from 'lucide-react';

type Props = {
  name: string;
  initials: string;
  topic?: string;
};
const { name, initials, topic } = Astro.props;
---

<figure class="group rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-lift)]">
  <Quote className="mb-4 text-[color:var(--terracotta)] transition-transform duration-300 group-hover:scale-110" size={24} strokeWidth={1.7} aria-hidden="true" />
  <blockquote class="text-sm leading-relaxed text-[color:var(--ink)]">
    <slot />
  </blockquote>
  <figcaption class="mt-5 flex items-center gap-3 border-t border-[color:var(--border)] pt-4">
    <span
      class="flex h-9 w-9 items-center justify-center rounded-full bg-[color:var(--accent-soft)] text-xs font-semibold text-[color:var(--accent)]"
      aria-hidden="true"
    >
      {initials}
    </span>
    <div class="leading-tight">
      <span class="block text-sm font-medium">{name}</span>
      {topic && <span class="text-xs text-[color:var(--ink-soft)]">{topic}</span>}
    </div>
  </figcaption>
</figure>
